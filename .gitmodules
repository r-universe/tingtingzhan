[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "DanielBiostatistics10th"]
	path = DanielBiostatistics10th
	url = https://github.com/tingtingzhan/danielbiostatistics10th
[submodule "DemographicTable"]
	path = DemographicTable
	url = https://github.com/tingtingzhan/demographictable
[submodule "Qindex"]
	path = Qindex
	url = https://github.com/cran/Qindex
[submodule "Qindex.data"]
	path = Qindex.data
	url = https://github.com/cran/Qindex.data
[submodule "QuantileGH"]
	path = QuantileGH
	url = https://github.com/cran/QuantileGH
[submodule "ThomasJeffersonUniv"]
	path = ThomasJeffersonUniv
	url = https://github.com/cran/ThomasJeffersonUniv
[submodule "TukeyGH77"]
	path = TukeyGH77
	url = https://github.com/cran/TukeyGH77
[submodule "VisualizeSimon2Stage"]
	path = VisualizeSimon2Stage
	url = https://github.com/tingtingzhan/visualizesimon2stage
[submodule "fmx"]
	path = fmx
	url = https://github.com/cran/fmx
[submodule "groupedHyperframe"]
	path = groupedHyperframe
	url = https://github.com/cran/groupedHyperframe
[submodule "groupedHyperframe.random"]
	path = groupedHyperframe.random
	url = https://github.com/cran/groupedHyperframe.random
[submodule "hyper.gam"]
	path = hyper.gam
	url = https://github.com/cran/hyper.gam
[submodule "ordPanel"]
	path = ordPanel
	url = https://github.com/tingtingzhan/ordpanel
[submodule "param2moment"]
	path = param2moment
	url = https://github.com/cran/param2moment
